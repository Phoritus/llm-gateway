{
  "title": "llm-gateway",
  "interval": 60,
  "rules": [
    {
      "uid": "llmgw-error-rate",
      "title": "Upstream error rate above 5%",
      "condition": "C",
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "More than 5% of routed /v1 requests ended in an upstream error, timeout or broken stream over 5 minutes. Only counted above 3 requests a minute."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "(sum(rate(gateway_requests_total{outcome=~\"upstream_error|timeout|unavailable|stream_error\"}[5m])) / sum(rate(gateway_requests_total{outcome!=\"refused\"}[5m]))) and on() sum(rate(gateway_requests_total[5m])) > 0.05",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.05
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-ttft-p95",
      "title": "p95 time to first token above 10s",
      "condition": "C",
      "for": "10m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "The 95th percentile time to the first chunk has been above 10 seconds for 10 minutes."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_time_to_first_token_seconds_bucket[5m])))",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    10
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-postgres-down",
      "title": "Postgres unreachable",
      "condition": "C",
      "for": "2m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "An instance cannot reach Postgres. The control plane and route resolution fail while it lasts."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "min(postgres_up)",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-redis-down",
      "title": "Redis unreachable",
      "condition": "C",
      "for": "2m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "An instance cannot reach Redis. /v1 rate limits fall back to each instance's own, and login is refused."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "min(redis_up)",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-usage-queue",
      "title": "Usage queue nearly full",
      "condition": "C",
      "for": "2m",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "The usage queue holds over 8000 events, 80% of the default USAGE_QUEUE_SIZE of 10000. Past it, the oldest events are dropped. Change this threshold with USAGE_QUEUE_SIZE."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "max(usage_queue_depth)",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    8000
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-usage-dropped",
      "title": "Usage events dropped",
      "condition": "C",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "Usage events were dropped in the last 10 minutes. The dashboard's Usage events dropped panel gives the reason."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "sum(increase(usage_events_dropped_total[10m]))",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "uid": "llmgw-not-reporting",
      "title": "Gateway not reporting",
      "condition": "C",
      "for": "5m",
      "noDataState": "Alerting",
      "execErrState": "Error",
      "labels": {
        "service": "llm-gateway"
      },
      "annotations": {
        "summary": "No instance has sent metrics for 5 minutes: the gateway is down, or its OTLP export is failing."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__PROM_UID__",
          "model": {
            "refId": "A",
            "expr": "count(postgres_up)",
            "instant": true
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    1
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}

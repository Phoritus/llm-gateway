      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, vendor) (rate(gateway_time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{vendor}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, vendor) (rate(gateway_time_to_first_token_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{vendor}}"
        }
      ]
    },

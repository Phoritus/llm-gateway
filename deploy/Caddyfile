{
	servers {
		# Without this Caddy replaces the X-Forwarded-For that Cloudflare
		# sends with the edge node's address, and every client behind one
		# node shares the gateway's rate-limit bucket.
		trusted_proxies static {$TRUSTED_PROXIES}
		trusted_proxies_strict
	}
}

{$DOMAIN} {
	reverse_proxy gateway-a:8080 gateway-b:8080 {
		health_uri /healthz
		health_interval 1s
		health_timeout 2s
		# A request that cannot reach either gateway, such as one sent while
		# both are restarting, waits for one instead of failing at once.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

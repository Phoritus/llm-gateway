# --- App ---
PORT=8080
APP_ENV=development
# Exact scheme://host[:port] origins allowed to call /api with credentials.
# No wildcards: /api sends cookies, and a wildcard origin with credentials
# would expose every session. An entry carrying a path, a query, a fragment or
# credentials is refused, and so is an empty list in production -- the
# same-origin guard then refuses every state-changing request a browser makes,
# so the control plane answers 403 to its own dashboard.
ALLOWED_ORIGINS=http://localhost:3000
# Where verification and reset links point: the dashboard's origin, which
# serves /verify-email and /reset-password. Required in production, and https
# there.
PUBLIC_BASE_URL=http://localhost:3000

# Public IP ranges of the proxies in front of this service, as CIDRs or single
# addresses. Rate-limit buckets are keyed on the client address, so whether
# X-Forwarded-For can be believed decides whether those limits exist at all: a
# client whose header is trusted can pick its own bucket.
#
# The private ranges (10/8, 172.16/12, 192.168/16, 100.64/10, link-local, ULA)
# are always treated as proxies, because no internet client can reach us from
# one -- so a platform router needs nothing here. Loopback is NOT trusted by
# default: put 127.0.0.1 here if a reverse proxy runs on this same host.
#
# Behind Cloudflare, list its ranges, from https://www.cloudflare.com/ips-v4
# and https://www.cloudflare.com/ips-v6. Getting this wrong fails safe in one
# direction only: a missing range means everyone behind one Cloudflare edge
# node shares a bucket (requests refused too early), while a range listed here
# that is not really a proxy lets anyone inside it spoof. On the VM,
# deploy/trusted-proxies.env sets this; "make cloudflare-ips" refreshes it.
TRUSTED_PROXIES=

# --- Database and Redis ---
# Development and production read different variable names, and neither falls
# back to the other:
#
#   APP_ENV=development  ->  DATABASE_URL_LOCAL, REDIS_URL_LOCAL
#   APP_ENV=production   ->  DATABASE_URL,       REDIS_URL
#
# That is deliberate. With one name for both, a local and a remote URL compete
# for the same line: a second DATABASE_URL further down the file wins silently,
# and a service started for local work migrates and writes to the production
# database with nothing in its output to say which one it opened. Separate
# names mean both can sit in this file at once, each saying what it is. Setting
# DATABASE_URL_LOCAL to a remote URL is still allowed -- it is just no longer
# something that can happen by accident. `make run` now also refuses to start
# if any key appears twice in .env.
#
# POSTGRES_PORT and REDIS_PORT are the host ports docker-compose.yml publishes
# on. Move them if another Postgres or Redis already owns the default: Docker's
# publish loses that race silently, so connections reach the other server and
# fail authentication rather than failing to connect. `make env` detects this
# and picks free ports for you. Keep each URL in step with its port.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL_LOCAL=postgres://gateway:gateway@127.0.0.1:5432/llm_gateway?sslmode=disable
REDIS_URL_LOCAL=redis://127.0.0.1:6379

# Read only when APP_ENV=production. On a platform these come from its own
# environment settings rather than from a file; keep them here while APP_ENV
# is development and they stay inert.
# DATABASE_URL=postgres://gateway:gateway@db:5432/llm_gateway?sslmode=require
# REDIS_URL=redis://redis:6379

# --- Secrets you generate yourself ---
# The service refuses to start without both.
#   MASTER_KEY:     openssl rand -base64 32      (must decode to 32 bytes)
#   SESSION_SECRET: openssl rand -base64 48      (at least 32 characters)
MASTER_KEY=replace-with-32-random-bytes-in-base64
# Rotating: put the old key here (comma-separated if several), the new one in
# MASTER_KEY, deploy, then run rotate-keys. Remove it once rotate-keys reports
# no credential left under it.
# MASTER_KEY_PREVIOUS=
SESSION_SECRET=replace-with-a-long-random-string

# --- Sessions ---
# Absolute lifetime, and the idle window that ends an unused session sooner.
SESSION_TTL=336h
SESSION_IDLE_TTL=24h
# Leave empty to keep cookies host-only, which also enables the stricter
# __Host- cookie prefix in production. Set it only to share cookies across
# subdomains.
COOKIE_DOMAIN=

# --- Mailed tokens ---
# How long each emailed link stays usable. The reset window is short because
# the link is a password bypass; a verification link only proves an address.
VERIFICATION_TTL=24h
RESET_TTL=15m

# --- Data plane ---
# Deadline on one /v1 request, streaming included, so a stuck or abandoned
# generation stops costing anything.
V1_REQUEST_TIMEOUT=5m

# Limits on /v1, each per minute: requests, and tokens estimated at four
# characters each and corrected to the provider's reported usage afterwards.
# A whole minute's worth is available as burst. The per-key limits sit below
# the workspace's so that one key cannot starve the rest.
V1_KEY_RPM=120
V1_KEY_TPM=200000
V1_WORKSPACE_RPM=300
V1_WORKSPACE_TPM=500000
# Requests one workspace may have in flight at once, counted per instance.
V1_WORKSPACE_CONCURRENCY=20

# --- Shutdown ---
# The whole of a graceful shutdown, from SIGTERM to exit; at least 5s. The last
# 4s are kept for writing queued usage events and flushing telemetry. The rest
# is how long requests in flight get to finish before they are cut.
#
# It must end before the platform's kill. Render sends SIGKILL 30s after
# SIGTERM by default, so with these defaults a deploy cuts any stream that has
# about 20s or more left to run. Streams as long as V1_REQUEST_TIMEOUT survive
# a deploy only if both are raised together: Render's maxShutdownDelaySeconds
# (render.yaml or the API, 30 to 300, not for a service with a persistent disk)
# to 300, and this to 290s, which gives a request 286s to finish.
SHUTDOWN_TIMEOUT=25s

# --- Usage history ---
# Usage events wait in a queue of this size until they are written in batches.
# When it fills, the oldest are dropped and counted (usage.events.dropped).
USAGE_QUEUE_SIZE=10000
# How long raw per-request events are kept. The daily rollup the dashboard
# charts is kept for good.
USAGE_RETENTION=720h

# --- Exact cache ---
# How long an answer is served to an identical request. Which requests are
# cached is each route's own setting (cache: auto, always or off). 0 turns the
# exact cache off for every route.
CACHE_TTL=1h

# --- Email ---
# Mail is load-bearing: an account cannot use the service until its address is
# confirmed, so a deployment that cannot send is a deployment nobody can sign
# up for.
#
# Leave SMTP_URL empty in development and links are written to the log, which
# is how you read them without a provider. APP_ENV=production refuses to start
# without it, because that fallback puts a password-reset link -- a 15-minute
# account takeover -- into the log of a free-tier host.
#
#   smtp://user:password@host:587    STARTTLS, what hosted providers document
#   smtps://user:password@host:465   TLS from the first byte
#
# Percent-encode a password containing @ / : or #. A relay that offers neither
# STARTTLS nor implicit TLS is refused unless it is on localhost.
SMTP_URL=
# The envelope sender. Required in production, where the no-reply@localhost
# default is rejected by every real relay.
MAIL_FROM=no-reply@localhost

# --- Feature flags ---
# SEMANTIC_CACHE needs a Redis 8 with vector sets, named by VECTOR_REDIS_URL in
# production and VECTOR_REDIS_URL_LOCAL elsewhere, and required only when the
# flag is on. Upstash has no vector sets, so REDIS_URL cannot stand in. On the
# VM it is the compose redis service: VECTOR_REDIS_URL=redis://redis:6379. A
# workspace also opts in through its settings (semantic_cache_enabled).
SEMANTIC_CACHE=off
# VECTOR_REDIS_URL_LOCAL=redis://127.0.0.1:6379
# VECTOR_REDIS_URL=redis://redis:6379
# CONTEXT_HANDOFF applies each route's context_handoff setting (reorder by
# default, or trim, or off). Off, every route sends requests as they came.
CONTEXT_HANDOFF=off

# --- OpenTelemetry ---
# Metrics and traces are exported over OTLP/HTTP. These are the SDK's standard
# variables, so the same code reaches the local stack or Grafana Cloud with no
# change. An empty OTEL_EXPORTER_OTLP_ENDPOINT turns telemetry off; production
# logs a warning when it is empty.
OTEL_SERVICE_NAME=llm-gateway
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Local: "make obs-up" starts Grafana (http://127.0.0.1:3000, admin/admin) and
# an OTLP receiver. OTLP_HTTP_PORT and GRAFANA_PORT move the host ports.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Grafana Cloud: use these two instead of the endpoint above. The headers value
# is a secret (it carries the access token). Set it in the deployment's own
# settings, never in a file that is committed or shared. The SDK reads it
# directly; the service neither parses nor logs it. Percent-encode the space
# after "Basic" as %20 if your platform requires it.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-xx-region-n.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace-with-base64-of-instanceid-and-token

# make grafana: where to apply deploy/grafana's dashboard and alerts. Read by
# the script only, never by the service. GRAFANA_TOKEN is a service account
# token (Editor, plus alert rule write) and a secret: keep it in .env.dev.
# Without GRAFANA_URL it applies to the local Grafana from make obs-up.
# GRAFANA_URL=https://your-stack.grafana.net
# GRAFANA_TOKEN=

# Trace sampling. Metrics are never sampled. In production keep the ratio low:
# 1.0 records every request.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# Read only by "make ssh", "make deploy" and "make vm-logs" on your own
# machine; the service ignores them. VM_HOST is the VM's DNS name or public IP,
# VM_KEY the private key Azure gave you when it created the VM; a relative path
# is read from the repo root, where *.pem is gitignored.
VM_HOST=
VM_USER=azureuser
VM_KEY=llm-gateway_key.pem
